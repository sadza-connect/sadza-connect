# ==============================================================================
# Sadza Connect Zimbabwe — Backend Environment Configuration Example
# Copy this file to .env and configure with your environment-specific credentials
# ==============================================================================

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# JWT Authentication
# Generate strong 256-bit random keys: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sadza-connect
JWT_AUDIENCE=sadza-app

# PostgreSQL / Supabase Database Direct Connection
# Used by Knex for connection pool and migrations
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_SSL=true
# Optional full direct URL (overrides separate DB_* parameters if present)
# DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Email Delivery
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Sadza Connect <noreply@sadzaconnect.co.zw>
