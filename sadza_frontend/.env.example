# ==============================================================================
# Sadza Connect Zimbabwe — Frontend Environment Configuration Example
# Copy this file to .env.local for local development
# ==============================================================================

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API URL (Express Microservice)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Supabase API Configuration (Phase 2 Database, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase Service Role Key (NEVER expose to browser/client-side)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
