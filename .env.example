# ==============================================================================
# Sadza Connect Zimbabwe — Root Environment Configuration Reference
# ==============================================================================
# For service-specific configurations, please see:
# - Frontend: sadza_frontend/.env.example
# - Backend:  sadza_backend/.env.example
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Variables (sadza_frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Backend Variables (sadza_backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
API_PREFIX=/api/v1

CORS_ORIGINS=https://sadzaconnect.co.zw,http://localhost:3000
FRONTEND_URL=https://sadzaconnect.co.zw

JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sadza-connect
JWT_AUDIENCE=sadza-app

DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_SSL=true
# DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Sadza Connect <noreply@sadzaconnect.co.zw>
